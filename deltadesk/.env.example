# Required for live analyst and forecaster decisions.
GEMINI_API_KEY=
GEMINI_THINKING_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=high

# Optional deterministic data mode. Add --gemini-thinking to run_agents.py to
# keep these inputs while still using real Gemini decisions.
MOCK_MODE=false

# Primary persistence; omitted means local SQLite.
ACTIAN_DATABASE_URL=

# Bounded once-daily performance learning.
LEARNING_ENABLED=true
LEARNING_LOOKBACK_DAYS=60
LEARNING_MARKET_DATA_DAYS=120
LEARNING_MIN_OBSERVATIONS=3
LEARNING_RATE=0.15
LEARNING_MAX_WEIGHT_STEP=0.05
LEARNING_MIN_SOURCE_WEIGHT=0.10
PERFORMANCE_FULL_SCALE_PCT=2.0
HOLD_BAND_PCT=0.5
